---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES, byCategory } from '../../../data/calculators';
import type { Category } from '../../../data/calculators';
import { locales, t, navLabel, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    CATEGORIES.map((c) => ({ params: { lang, category: c.slug } }))
  );
}

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const calcs = byCategory(category);
const title = navLabel(lang, category);
---

<BaseLayout title={title} description={t(lang, 'cat.lead')} lang={lang} path={`/categories/${category}/`}>
  <p class="muted"><a href={`/${lang}/`}>{t(lang, 'common.home')}</a> › {title}</p>
  <h1>{title}</h1>
  <p class="lead">{t(lang, 'cat.lead')}</p>

  <div class="grid">
    {calcs.map((c) => (
      <a class="card" href={`/${lang}/calculators/${c.slug}/`}>
        <span class="cat">{c.priority === 'mvp' ? t(lang, 'common.popular') : navLabel(lang, c.category)}</span>
        <div class="name">{c.title}{c.live ? <span class="badge">live</span> : null}</div>
      </a>
    ))}
  </div>
</BaseLayout>

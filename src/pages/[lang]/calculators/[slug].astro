---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import MulchCalculator from '../../../components/MulchCalculator.astro';
import GravelCalculator from '../../../components/GravelCalculator.astro';
import ConcreteSlabCalculator from '../../../components/ConcreteSlabCalculator.astro';
import FlooringCalculator from '../../../components/FlooringCalculator.astro';
import PaintCalculator from '../../../components/PaintCalculator.astro';
import BoardFeetCalculator from '../../../components/BoardFeetCalculator.astro';
import SodCalculator from '../../../components/SodCalculator.astro';
import PaverCalculator from '../../../components/PaverCalculator.astro';
import DeckingCalculator from '../../../components/DeckingCalculator.astro';
import TileCalculator from '../../../components/TileCalculator.astro';
import CoverageCalculator from '../../../components/CoverageCalculator.astro';
import {
  CALCULATORS,
  getCalculator,
  byCategory,
} from '../../../data/calculators';
import { calculatorLabels, calculatorTitle, locales, t, navLabel, type Lang } from '../../../i18n/ui';
import { getGuide } from '../../../data/guides';
import { getFormula } from '../../../data/formulas';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    CALCULATORS.map((c) => ({ params: { lang, slug: c.slug } }))
  );
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const calc = getCalculator(slug)!;
const related = byCategory(calc.category)
  .filter((c) => c.live && c.slug !== calc.slug)
  .slice(0, 6);
const localizedTitle = calculatorTitle(lang, calc.slug, calc.title);
const labels = calculatorLabels(lang);
const guide = getGuide(lang, calc.slug);
const formula = lang === 'en' ? getFormula(calc.slug) : undefined;
const REVIEW_DATE = '2026-06-09';
const dateLocales: Record<Lang, string> = {
  en: 'en-US',
  es: 'es-ES',
  de: 'de-DE',
  zh: 'zh-CN',
};
const reviewDateDisplay = new Intl.DateTimeFormat(dateLocales[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${REVIEW_DATE}T00:00:00Z`));
function metaSnippet(text: string): string {
  const clean = text.replace(/\s+/g, ' ').trim();
  const firstSentence = clean.match(/^.+?[.!?。]/)?.[0] ?? clean;
  if (firstSentence.length <= 155) return firstSentence;
  return `${firstSentence.slice(0, 152).replace(/\s+\S*$/, '')}...`;
}
const metaFromGuide = guide?.intro
  ? `${localizedTitle}: ${metaSnippet(guide.intro)}`
  : undefined;
const description = calc.metaDescription ?? metaFromGuide ?? `${localizedTitle}: ${t(lang, 'calc.metaBody')}`;
const noun = localizedTitle.replace(' Calculator', '');

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: localizedTitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  dateModified: REVIEW_DATE,
  isAccessibleForFree: true,
  featureList: [
    'interactive material quantity calculator',
    'waste allowance',
    'optional cost estimate',
    'visible calculation guidance',
  ],
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'common.home'), item: new URL(`/${lang}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: navLabel(lang, calc.category), item: new URL(`/${lang}/categories/${calc.category}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: localizedTitle },
  ],
};

const faqItems = [
  ...(guide?.faq ?? []),
  { q: t(lang, 'faq.q1'), a: t(lang, 'faq.a1') },
  { q: t(lang, 'faq.q2'), a: t(lang, 'faq.a2') },
];
---

<BaseLayout
  title={`${localizedTitle} - ${t(lang, 'calc.howto')}`}
  description={description}
  lang={lang}
  path={`/calculators/${calc.slug}/`}
  jsonLd={[webApp, breadcrumb]}
  noindex={!calc.live}
>
  <p class="breadcrumb">
    <a href={`/${lang}/`}>{t(lang, 'common.home')}</a><span>/</span>
    <a href={`/${lang}/categories/${calc.category}/`}>{navLabel(lang, calc.category)}</a>
  </p>
  <section class="content-narrow">
    <span class="eyebrow">{navLabel(lang, calc.category)}</span>
    <h1>{localizedTitle}</h1>
    <p class="lead">{t(lang, 'calc.lead')}</p>
    {calc.live && (
      <p class="review-note">
        {t(lang, 'common.lastReviewed')}: <time datetime={REVIEW_DATE}>{reviewDateDisplay}</time>
      </p>
    )}
  </section>

  {calc.live && (
    <section class="answer-panel" aria-labelledby="answer-first-heading">
      <div>
        <span class="eyebrow">{t(lang, 'calc.answerFirst')}</span>
        <h2 id="answer-first-heading">{localizedTitle}</h2>
        <p>{t(lang, 'calc.answerBody')}</p>
      </div>
      <div class="quality-grid" aria-label={t(lang, 'calc.estimateIncludes')}>
        <div class="quality-item">
          <h3>{t(lang, 'calc.estimateIncludes')}</h3>
          <ul>
            <li>{t(lang, 'calc.includesArea')}</li>
            <li>{t(lang, 'calc.includesWaste')}</li>
            <li>{t(lang, 'calc.includesRounding')}</li>
          </ul>
        </div>
        <div class="quality-item">
          <h3>{t(lang, 'calc.beforeBuying')}</h3>
          <ul>
            <li>{t(lang, 'calc.confirmCoverage')}</li>
            <li>{t(lang, 'calc.confirmBatch')}</li>
            <li>{t(lang, 'calc.confirmConditions')}</li>
          </ul>
        </div>
      </div>
    </section>
  )}

  {calc.slug === 'mulch-calculator' ? (
    <MulchCalculator lang={lang} />
  ) : calc.slug === 'gravel-calculator' ? (
    <GravelCalculator lang={lang} />
  ) : calc.slug === 'concrete-slab-calculator' ? (
    <ConcreteSlabCalculator lang={lang} />
  ) : calc.slug === 'laminate-flooring-calculator' || calc.slug === 'vinyl-plank-flooring-calculator' ? (
    <FlooringCalculator lang={lang} />
  ) : calc.slug === 'interior-paint-calculator' ? (
    <PaintCalculator lang={lang} />
  ) : calc.slug === 'board-feet-lumber-calculator' ? (
    <BoardFeetCalculator lang={lang} />
  ) : calc.slug === 'sod-calculator' ? (
    <SodCalculator lang={lang} />
  ) : calc.slug === 'paver-calculator' ? (
    <PaverCalculator lang={lang} />
  ) : calc.slug === 'decking-board-calculator' ? (
    <DeckingCalculator lang={lang} />
  ) : calc.slug === 'crushed-stone-calculator' ? (
    <GravelCalculator defaultDensity={1.35} lang={lang} />
  ) : calc.slug === 'topsoil-calculator' ? (
    <GravelCalculator defaultDensity={1.1} lang={lang} />
  ) : calc.slug === 'sand-calculator' ? (
    <GravelCalculator defaultDensity={1.35} lang={lang} />
  ) : calc.slug === 'river-rock-calculator' ? (
    <GravelCalculator defaultDensity={1.4} lang={lang} />
  ) : calc.slug === 'hardwood-flooring-calculator' || calc.slug === 'engineered-wood-flooring-calculator' || calc.slug === 'carpet-calculator' ? (
    <FlooringCalculator lang={lang} />
  ) : calc.slug === 'floor-tile-calculator' || calc.slug === 'backsplash-tile-calculator' ? (
    <TileCalculator lang={lang} />
  ) : calc.slug === 'exterior-paint-calculator' ? (
    <PaintCalculator lang={lang} />
  ) : calc.slug === 'concrete-footing-calculator' ? (
    <ConcreteSlabCalculator lang={lang} />
  ) : calc.slug === 'drywall-calculator' ? (
    <CoverageCalculator unitLabel={labels.sheets} defaultCoverage={32} coverageLabel={labels.sheetCoverage} lang={lang} />
  ) : calc.slug === 'roofing-shingle-calculator' ? (
    <CoverageCalculator unitLabel={labels.bundles} defaultCoverage={33} coverageLabel={labels.bundleCoverage} lang={lang} />
  ) : calc.slug === 'siding-calculator' ? (
    <CoverageCalculator unitLabel={labels.squares} defaultCoverage={100} coverageLabel={labels.squareCoverage} lang={lang} />
  ) : (
    <div class="calc"><p class="muted">{t(lang, 'calc.comingSoon')}</p></div>
  )}

  <h2>{t(lang, 'calc.howto')} · {noun}</h2>
  <div class="guide-panel">
    {guide ? (
      <Fragment>
        <p>{guide.intro}</p>
        <ol class="guide-steps">{guide.steps.map((s) => <li>{s}</li>)}</ol>
      </Fragment>
    ) : (
      <p>{t(lang, 'calc.guideIntro')}</p>
    )}
  </div>

  {formula && (
    <section class="formula-panel" aria-labelledby="formula-heading">
      <span class="eyebrow">Formula</span>
      <h2 id="formula-heading">{formula.label}</h2>
      <code>{formula.expression}</code>
      <ul>
        {formula.notes.map((note) => <li>{note}</li>)}
      </ul>
    </section>
  )}

  <h2>{t(lang, 'calc.order')}</h2>
  {guide && guide.factors.length > 0 ? (
    <ul class="factor-list">
      {guide.factors.map((f) => (
        <li><strong>{f.label}.</strong> {f.detail}</li>
      ))}
    </ul>
  ) : (
    <p>{t(lang, 'calc.orderGuide')}</p>
  )}

  {guide?.scenarios && guide.scenarios.length > 0 && (
    <Fragment>
      <h2>{t(lang, 'calc.quickAnswers')}</h2>
      <dl class="scenario-list">
        {guide.scenarios.map((s) => (
          <Fragment>
            <dt>{s.q}</dt>
            <dd>{s.a}</dd>
          </Fragment>
        ))}
      </dl>
    </Fragment>
  )}

  {related.length > 0 && (
    <Fragment>
      <h2>{t(lang, 'calc.related')}</h2>
      <div class="grid">
        {related.map((r) => (
          <a class="card" href={`/${lang}/calculators/${r.slug}/`}>
            <span class="cat">{navLabel(lang, r.category)}</span>
            <div class="name">{calculatorTitle(lang, r.slug, r.title)}</div>
          </a>
        ))}
      </div>
    </Fragment>
  )}

  <CtaBlock lang={lang} />

  <Faq items={faqItems} title={t(lang, 'faq.title')} />

  <p class="notice">{t(lang, 'calc.disclaimer')}</p>
</BaseLayout>

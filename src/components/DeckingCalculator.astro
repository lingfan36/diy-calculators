---
// Interactive decking board calculator. Server-rendered markup, client-side
// math importing the same pure function the unit tests use.
import { calculatorLabels, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const labels = calculatorLabels(lang);
---

<div class="calc" id="deck-calc">
  <div class="row">
    <label>{labels.deckLength}
      <input type="number" id="d-length" min="0" step="any" value="16" />
    </label>
    <label>{labels.deckWidth}
      <input type="number" id="d-width" min="0" step="any" value="12" />
    </label>
  </div>
  <div class="row">
    <label>{labels.boardWidth}
      <input type="number" id="d-bwid" min="0" step="any" value="5.5" />
    </label>
    <label>{labels.boardLength}
      <input type="number" id="d-blen" min="0" step="any" value="8" />
    </label>
    <label>{labels.waste}
      <select id="d-waste">
        <option value="5">5%</option>
        <option value="10" selected>10%</option>
        <option value="15">15%</option>
      </select>
    </label>
    <label>{labels.priceBoard}
      <input type="number" id="d-price" min="0" step="any" placeholder={`${labels.example} 22`} />
    </label>
  </div>
  <button id="d-go" type="button">{labels.calculate}</button>

  <div class="result hidden" id="d-result" aria-live="polite">
    <p>{labels.youNeed} <span class="big" id="d-boards">0</span> {labels.boards}</p>
    <p id="d-detail" class="muted"></p>
  </div>
</div>

<script type="application/json" id="d-labels" set:html={JSON.stringify(labels)} />

<script>
  import { calcDecking } from '../lib/calc/decking';

  const labels = JSON.parse(document.getElementById('d-labels')?.textContent || '{}');
  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('d-price').value;
    const r = calcDecking({
      length: num('d-length'),
      width: num('d-width'),
      boardWidthInches: num('d-bwid'),
      boardLengthFeet: num('d-blen'),
      wastePercent: parseFloat(byId('d-waste').value),
      pricePerBoard: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('d-boards').textContent = String(r.boards);
    const cost = r.estCost !== null ? ` · ${labels.estCost} $${r.estCost}` : '';
    byId('d-detail').textContent =
      `${r.deckAreaSqFt} ft² · ${r.boardCoverageSqFt} ft²/${labels.boards} -> ${r.boards} ${labels.boards}${cost}`;
    document.getElementById('d-result')!.classList.remove('hidden');
  }

  document.getElementById('d-go')!.addEventListener('click', run);
  run();
</script>

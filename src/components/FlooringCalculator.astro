---
// Interactive flooring calculator (laminate / vinyl plank / box-sold flooring).
// Server-rendered markup, client-side math importing the shared pure function.
import { calculatorLabels, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const labels = calculatorLabels(lang);
---

<div class="calc" id="floor-calc">
  <div class="row">
    <label>{labels.roomLength}
      <input type="number" id="f-length" min="0" step="any" value="12" />
    </label>
    <label>{labels.roomWidth}
      <input type="number" id="f-width" min="0" step="any" value="10" />
    </label>
  </div>
  <div class="row">
    <label>{labels.coveragePerBox}
      <input type="number" id="f-cov" min="0" step="any" value="20" />
    </label>
    <label>{labels.waste}
      <select id="f-waste">
        <option value="5">5%</option>
        <option value="10" selected>10%</option>
        <option value="15">15%</option>
      </select>
    </label>
    <label>{labels.priceBox}
      <input type="number" id="f-price" min="0" step="any" placeholder={`${labels.example} 35`} />
    </label>
  </div>
  <button id="f-go" type="button">{labels.calculate}</button>

  <div class="result hidden" id="f-result" aria-live="polite">
    <p>{labels.youNeed} <span class="big" id="f-boxes">0</span> {labels.boxes}</p>
    <p id="f-detail" class="muted"></p>
  </div>
</div>

<script type="application/json" id="f-labels" set:html={JSON.stringify(labels)} />

<script>
  import { calcFlooring } from '../lib/calc/flooring';

  const labels = JSON.parse(document.getElementById('f-labels')?.textContent || '{}');
  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('f-price').value;
    const r = calcFlooring({
      length: num('f-length'),
      width: num('f-width'),
      boxCoverage: num('f-cov'),
      wastePercent: parseFloat(byId('f-waste').value),
      pricePerBox: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('f-boxes').textContent = String(r.boxes);
    const cost = r.estCost !== null ? ` · ${labels.estCost} $${r.estCost}` : '';
    byId('f-detail').textContent =
      `${r.areaSqFt} ft² ${labels.plusWaste} ${r.areaWithWaste} ft² -> ${r.boxes} ${labels.boxes}${cost}`;
    document.getElementById('f-result')!.classList.remove('hidden');
  }

  document.getElementById('f-go')!.addEventListener('click', run);
  run();
</script>

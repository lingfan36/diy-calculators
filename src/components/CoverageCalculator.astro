---
// Generic "area ÷ flat coverage" calculator (drywall sheets, roofing bundles,
// siding squares, ...). Reuses the flooring pure function. The unit label is
// rendered into the DOM so the client script can read it without define:vars.
interface Props {
  unitLabel?: string; // plural, e.g. "sheets"
  defaultCoverage?: number; // ft² covered by one unit
  coverageLabel?: string;
}
const {
  unitLabel = 'pieces',
  defaultCoverage = 32,
  coverageLabel = 'Coverage per unit (ft²)',
} = Astro.props;
---

<div class="calc" id="cov-calc">
  <div class="row">
    <label>Length (ft)
      <input type="number" id="c-length" min="0" step="any" value="10" />
    </label>
    <label>Width (ft)
      <input type="number" id="c-width" min="0" step="any" value="10" />
    </label>
  </div>
  <div class="row">
    <label>{coverageLabel}
      <input type="number" id="c-cov" min="0" step="any" value={defaultCoverage} />
    </label>
    <label>Waste
      <select id="c-waste">
        <option value="5">5%</option>
        <option value="10" selected>10%</option>
        <option value="15">15%</option>
      </select>
    </label>
    <label>Price / unit ($, optional)
      <input type="number" id="c-price" min="0" step="any" placeholder="e.g. 15" />
    </label>
  </div>
  <button id="c-go" type="button">Calculate</button>

  <div class="result hidden" id="c-result" aria-live="polite">
    <p>You need <span class="big" id="c-units">0</span> <span id="c-unit-label">{unitLabel}</span></p>
    <p id="c-detail" class="muted"></p>
  </div>
</div>

<script>
  import { calcFlooring } from '../lib/calc/flooring';

  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const label = document.getElementById('c-unit-label')?.textContent || 'units';
    const priceRaw = byId('c-price').value;
    const r = calcFlooring({
      length: num('c-length'),
      width: num('c-width'),
      boxCoverage: num('c-cov'),
      wastePercent: parseFloat(byId('c-waste').value),
      pricePerBox: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('c-units').textContent = String(r.boxes);
    const cost = r.estCost !== null ? ` · est. cost $${r.estCost}` : '';
    byId('c-detail').textContent =
      `${r.areaSqFt} ft² + waste = ${r.areaWithWaste} ft² → ${r.boxes} ${label}${cost}`;
    document.getElementById('c-result')!.classList.remove('hidden');
  }

  document.getElementById('c-go')!.addEventListener('click', run);
  run();
</script>

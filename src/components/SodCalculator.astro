---
// Interactive sod calculator. Server-rendered markup, client-side math
// importing the same pure function the unit tests use.
import { calculatorLabels, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const labels = calculatorLabels(lang);
---

<div class="calc" id="sod-calc">
  <div class="row">
    <label>{labels.length}
      <input type="number" id="o-length" min="0" step="any" value="30" />
    </label>
    <label>{labels.width}
      <input type="number" id="o-width" min="0" step="any" value="20" />
    </label>
  </div>
  <div class="row">
    <label>{labels.rollCoverage}
      <input type="number" id="o-roll" min="0" step="any" value="10" />
    </label>
    <label>{labels.waste}
      <select id="o-waste">
        <option value="5" selected>5%</option>
        <option value="10">10%</option>
      </select>
    </label>
    <label>{labels.priceSqft}
      <input type="number" id="o-price" min="0" step="any" placeholder={`${labels.example} 0.45`} />
    </label>
  </div>
  <button id="o-go" type="button">{labels.calculate}</button>

  <div class="result hidden" id="o-result" aria-live="polite">
    <p>{labels.youNeed} <span class="big" id="o-rolls">0</span> {labels.rolls}</p>
    <p id="o-detail" class="muted"></p>
  </div>
</div>

<script type="application/json" id="o-labels" set:html={JSON.stringify(labels)} />

<script>
  import { calcSod } from '../lib/calc/sod';

  const labels = JSON.parse(document.getElementById('o-labels')?.textContent || '{}');
  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('o-price').value;
    const r = calcSod({
      length: num('o-length'),
      width: num('o-width'),
      rollCoverage: num('o-roll'),
      wastePercent: parseFloat(byId('o-waste').value),
      pricePerSqFt: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('o-rolls').textContent = String(r.rolls);
    const cost = r.estCost !== null ? ` · ${labels.estCost} $${r.estCost}` : '';
    byId('o-detail').textContent =
      `${r.areaWithWaste} ft² (${labels.withWaste}) -> ${r.rolls} ${labels.rolls} / ${r.pallets} ${labels.pallets}${cost}`;
    document.getElementById('o-result')!.classList.remove('hidden');
  }

  document.getElementById('o-go')!.addEventListener('click', run);
  run();
</script>

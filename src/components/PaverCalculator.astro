---
// Interactive paver calculator. Server-rendered markup, client-side math
// importing the same pure function the unit tests use.
import { calculatorLabels, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const labels = calculatorLabels(lang);
---

<div class="calc" id="paver-calc">
  <div class="row">
    <label>{labels.patioLength}
      <input type="number" id="v-length" min="0" step="any" value="12" />
    </label>
    <label>{labels.patioWidth}
      <input type="number" id="v-width" min="0" step="any" value="10" />
    </label>
  </div>
  <div class="row">
    <label>{labels.paverLength}
      <input type="number" id="v-plen" min="0" step="any" value="12" />
    </label>
    <label>{labels.paverWidth}
      <input type="number" id="v-pwid" min="0" step="any" value="12" />
    </label>
    <label>{labels.waste}
      <select id="v-waste">
        <option value="5">5%</option>
        <option value="10" selected>10%</option>
        <option value="15">15%</option>
      </select>
    </label>
    <label>{labels.pricePaver}
      <input type="number" id="v-price" min="0" step="any" placeholder={`${labels.example} 2.50`} />
    </label>
  </div>
  <button id="v-go" type="button">{labels.calculate}</button>

  <div class="result hidden" id="v-result" aria-live="polite">
    <p>{labels.youNeed} <span class="big" id="v-pavers">0</span> {labels.pavers}</p>
    <p id="v-detail" class="muted"></p>
  </div>
</div>

<script type="application/json" id="v-labels" set:html={JSON.stringify(labels)} />

<script>
  import { calcPaver } from '../lib/calc/paver';

  const labels = JSON.parse(document.getElementById('v-labels')?.textContent || '{}');
  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('v-price').value;
    const r = calcPaver({
      length: num('v-length'),
      width: num('v-width'),
      paverLengthInches: num('v-plen'),
      paverWidthInches: num('v-pwid'),
      wastePercent: parseFloat(byId('v-waste').value),
      pricePerPaver: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('v-pavers').textContent = String(r.pavers);
    const cost = r.estCost !== null ? ` · ${labels.estCost} $${r.estCost}` : '';
    byId('v-detail').textContent =
      `${r.areaSqFt} ft² · ${r.paverAreaSqFt} ft²/${labels.pavers} -> ${r.pavers} ${labels.pavers}${cost}`;
    document.getElementById('v-result')!.classList.remove('hidden');
  }

  document.getElementById('v-go')!.addEventListener('click', run);
  run();
</script>

---
// Interactive tile calculator (floor / backsplash). Reuses the paver pure
// function (area ÷ single-tile face). Server markup + client TS.
import { calculatorLabels, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const labels = calculatorLabels(lang);
---

<div class="calc" id="tile-calc">
  <div class="row">
    <label>{labels.areaLength}
      <input type="number" id="t-length" min="0" step="any" value="10" />
    </label>
    <label>{labels.areaWidth}
      <input type="number" id="t-width" min="0" step="any" value="10" />
    </label>
  </div>
  <div class="row">
    <label>{labels.tileLength}
      <input type="number" id="t-tlen" min="0" step="any" value="12" />
    </label>
    <label>{labels.tileWidth}
      <input type="number" id="t-twid" min="0" step="any" value="12" />
    </label>
    <label>{labels.waste}
      <select id="t-waste">
        <option value="10" selected>10%</option>
        <option value="15">15%</option>
        <option value="20">20%</option>
      </select>
    </label>
    <label>{labels.priceTile}
      <input type="number" id="t-price" min="0" step="any" placeholder={`${labels.example} 3.50`} />
    </label>
  </div>
  <button id="t-go" type="button">{labels.calculate}</button>

  <div class="result hidden" id="t-result" aria-live="polite">
    <p>{labels.youNeed} <span class="big" id="t-tiles">0</span> {labels.tiles}</p>
    <p id="t-detail" class="muted"></p>
  </div>
</div>

<script type="application/json" id="t-labels" set:html={JSON.stringify(labels)} />

<script>
  import { calcPaver } from '../lib/calc/paver';

  const labels = JSON.parse(document.getElementById('t-labels')?.textContent || '{}');
  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('t-price').value;
    const r = calcPaver({
      length: num('t-length'),
      width: num('t-width'),
      paverLengthInches: num('t-tlen'),
      paverWidthInches: num('t-twid'),
      wastePercent: parseFloat(byId('t-waste').value),
      pricePerPaver: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('t-tiles').textContent = String(r.pavers);
    const cost = r.estCost !== null ? ` · ${labels.estCost} $${r.estCost}` : '';
    byId('t-detail').textContent =
      `${r.areaSqFt} ft² · ${r.paverAreaSqFt} ft²/${labels.tiles} -> ${r.pavers} ${labels.tiles}${cost}`;
    document.getElementById('t-result')!.classList.remove('hidden');
  }

  document.getElementById('t-go')!.addEventListener('click', run);
  run();
</script>

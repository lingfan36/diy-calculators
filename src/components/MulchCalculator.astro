---
// Interactive mulch calculator. Markup is server-rendered (SEO-friendly);
// the math runs client-side, importing the SAME pure function the unit tests use.
---

<div class="calc" id="mulch-calc">
  <div class="row">
    <label>Length (ft)
      <input type="number" id="m-length" min="0" step="any" value="10" />
    </label>
    <label>Width (ft)
      <input type="number" id="m-width" min="0" step="any" value="10" />
    </label>
  </div>
  <div class="row">
    <label>Depth (in)
      <select id="m-depth">
        <option value="2">2"</option>
        <option value="3" selected>3"</option>
        <option value="4">4"</option>
      </select>
    </label>
    <label>Bag size (ft³)
      <input type="number" id="m-bag" min="0.1" step="any" value="2" />
    </label>
    <label>Price / yd³ ($, optional)
      <input type="number" id="m-price" min="0" step="any" placeholder="e.g. 35" />
    </label>
  </div>
  <button id="m-go" type="button">Calculate</button>

  <div class="result hidden" id="m-result" aria-live="polite">
    <p>You need <span class="big" id="m-yards">0</span> cubic yards of mulch</p>
    <p id="m-detail" class="muted"></p>
  </div>
</div>

<script>
  import { calcMulch } from '../lib/calc/mulch';

  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('m-price').value;
    const r = calcMulch({
      length: num('m-length'),
      width: num('m-width'),
      depthInches: parseFloat(byId('m-depth').value),
      bagSizeCuFt: num('m-bag'),
      pricePerYard: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('m-yards').textContent = String(r.cubicYards);
    const cost = r.estCost !== null ? ` · est. cost $${r.estCost}` : '';
    byId('m-detail').textContent =
      `${r.areaSqFt} ft² area · ${r.cubicFeet} ft³ · about ${r.bags} bags${cost}`;
    document.getElementById('m-result')!.classList.remove('hidden');
  }

  document.getElementById('m-go')!.addEventListener('click', run);
  run(); // show a default result on load
</script>

---
// Interactive board feet calculator. Server-rendered markup, client-side math
// importing the same pure function the unit tests use.
---

<div class="calc" id="bf-calc">
  <div class="row">
    <label>Thickness (in)
      <input type="number" id="b-thick" min="0" step="any" value="1" />
    </label>
    <label>Width (in)
      <input type="number" id="b-width" min="0" step="any" value="6" />
    </label>
    <label>Length (ft)
      <input type="number" id="b-length" min="0" step="any" value="8" />
    </label>
  </div>
  <div class="row">
    <label>Quantity (pieces)
      <input type="number" id="b-qty" min="1" step="1" value="1" />
    </label>
    <label>Price / board foot ($, optional)
      <input type="number" id="b-price" min="0" step="any" placeholder="e.g. 4.50" />
    </label>
  </div>
  <button id="b-go" type="button">Calculate</button>

  <div class="result hidden" id="b-result" aria-live="polite">
    <p>Total <span class="big" id="b-total">0</span> board feet</p>
    <p id="b-detail" class="muted"></p>
  </div>
</div>

<script>
  import { calcBoardFeet } from '../lib/calc/board-feet';

  const byId = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(byId(id).value);

  function run() {
    const priceRaw = byId('b-price').value;
    const r = calcBoardFeet({
      thicknessInches: num('b-thick'),
      widthInches: num('b-width'),
      lengthFeet: num('b-length'),
      quantity: num('b-qty'),
      pricePerBoardFoot: priceRaw ? parseFloat(priceRaw) : undefined,
    });
    byId('b-total').textContent = String(r.boardFeetTotal);
    const cost = r.estCost !== null ? ` · est. cost $${r.estCost}` : '';
    byId('b-detail').textContent =
      `${r.boardFeetEach} bf each × ${r.quantity} = ${r.boardFeetTotal} bf${cost}`;
    document.getElementById('b-result')!.classList.remove('hidden');
  }

  document.getElementById('b-go')!.addEventListener('click', run);
  run();
</script>

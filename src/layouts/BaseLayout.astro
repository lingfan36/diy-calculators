---
import '../styles/global.css';
import { CATEGORIES } from '../data/calculators';
import { locales, languages, t, navLabel, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** locale-relative path, starts with '/', e.g. '/calculators/mulch-calculator/' or '/' */
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, lang, path, jsonLd = [], noindex = false } = Astro.props;
const rel = path === '/' ? '/' : path;
const canonical = new URL(`/${lang}${rel}`, Astro.site).href;
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(`/${l}${rel}`, Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="brand" href={`/${lang}/`}>{t(lang, 'site.title')}</a>
        <nav>
          {CATEGORIES.map((c) => (
            <a href={`/${lang}/categories/${c.slug}/`}>{navLabel(lang, c.slug)}</a>
          ))}
        </nav>
        <details class="lang-select">
          <summary aria-label="Change language">
            <span class="lang-current">{languages[lang]}</span>
          </summary>
          <div class="lang-menu" role="menu">
          {locales.map((l) =>
            l === lang ? (
              <span class="lang-option is-active" role="menuitemcheckbox" aria-checked="true">
                <span class="lang-check" aria-hidden="true"></span>
                <span>{languages[l]}</span>
              </span>
            ) : (
              <a class="lang-option" role="menuitemcheckbox" aria-checked="false" href={alternates.find((a) => a.lang === l)!.href}>
                <span class="lang-check" aria-hidden="true"></span>
                <span>{languages[l]}</span>
              </a>
            )
          )}
          </div>
        </details>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <p class="muted">© {t(lang, 'site.title')} · {t(lang, 'site.footer')}</p>
        <nav class="footer-links" aria-label="Footer">
          <a href={`/${lang}/methodology/`}>{t(lang, 'common.methodology')}</a>
        </nav>
      </div>
    </footer>
    <script>
      const languageSelector = document.querySelector('.lang-select');
      if (languageSelector) {
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Node && !languageSelector.contains(target)) {
            languageSelector.removeAttribute('open');
          }
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            languageSelector.removeAttribute('open');
          }
        });
      }
    </script>
  </body>
</html>
